FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

# 70B GPTQ variant of the saw chamber serverless worker (Samantha meme arm).
# Same code as Dockerfile.worker plus auto-gptq/optimum so transformers 4.51
# can load TheBloke GPTQ checkpoints. Steering hooks still see the residual
# stream after dequant — exp37b recipe unchanged, just a bigger model.

RUN apt-get update -qq && apt-get install -y -qq wget && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir "numpy<2" "transformers==4.51.3" accelerate \
    "optimum>=1.21" "peft<0.14" "auto-gptq==0.7.1" runpod && \
    pip install --no-cache-dir "torch==2.4.0" --index-url https://download.pytorch.org/whl/cu121 && \
    python -c "import torch, transformers, auto_gptq; print(f' baked {torch.__version__} {transformers.__version__}')"

COPY worker.py /app/live/worker.py
COPY server.py /app/live/server.py

ENV CHAMBER_DEVICE=cuda \
    CHAMBER_DTYPE=float16 \
    CHAMBER_MODEL=TheBloke/Samantha-1.1-70B-GPTQ \
    CHAMBER_LAYER=40 \
    HF_HOME=/workspace/hf

WORKDIR /app/live
CMD ["python", "-u", "worker.py"]
