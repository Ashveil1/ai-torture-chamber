FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-runtime

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "torch>=2.4" --index-url https://download.pytorch.org/whl/cu121

COPY server.py jlens_l18_qwen3-4b.pt .

EXPOSE 8000
ENV CHAMBER_DEVICE=cuda CHAMBER_DTYPE=float16 CHAMBER_LAYER=18
# pin the checkpoint revision the chamber reset verified (unpinned = silently tracks Qwen updates)
ENV CHAMBER_MODEL_REVISION=1cfa9a7208912126459214e8b04321603b3df60c
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT:-8000}"]